# Core service configuration
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Optional API auth keys (leave blank to disable auth)
RAG_API_KEY=
GATEWAY_API_KEY=

# Service URLs
RAG_API_URL=http://127.0.0.1:9010
GATEWAY_URL=http://127.0.0.1:9100
RAG_URL=http://127.0.0.1:9010

# ── Model Backend ──
# Switch between "gemini", "openrouter", and "ngrok" by changing this single value:
MODEL_BACKEND=openrouter
EMBEDDING_BACKEND=fastembed

# Option A: Gemini (also used by the Executor below)
PLANNER_GEMINI_MODEL=gemini-2.5-pro

# Option B: OpenRouter (cloud API, no local server needed)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.8-flash

# Option C: ngrok / Local server (requires running notebook + tunnel)
MODEL_API_URL=https://your-ngrok-url.ngrok-free.app
NGROK_AUTHTOKEN=

# Project and data paths
PROJECT=contacts-app
PROJECT_NAME=contacts-app
APP_NAME='contacts app'
SRS_PATH=./data/inputs/Sample-Contacts-App-SRS.txt
FIGMA_PATH=./data/inputs/GENERATED_JSON.json

# Generation and simulation tuning
TOP_K=8
SIM_ROUNDS=3
SIM_FAIL_EVERY=5

# Debug/reset toggles for simulator_runner.py
DEBUG_TRACE=0
RESET_TESTS_FIRST=0
RESET_ALL_FIRST=0

# ── Executor (Droidrun) config ──
GEMINI_API_KEY=your_gemini_api_key_here
EXECUTOR_LLM_PROVIDER=OpenRouter
EXECUTOR_LLM_MODEL=qwen/qwen3.7-flash
EXECUTOR_TIMEOUT=300
EXECUTOR_ROUNDS=10
EXECUTOR_MAX_STEPS=30
TARGET_APP_PACKAGE=com.android.contacts

# ── Web player (Playwright) — see web_player/ ──
# Only needed to test a WEBSITE. The Android path ignores everything below.
# The site under test. No default: an unconfigured run must fail, not drive
# whatever site a default happens to name.
WEB_BASE_URL=
WEB_SITE_NAME=
WEB_BROWSER=chromium
# false = watch the browser drive the site (default). true = for CI/long batches.
WEB_HEADLESS=false
# Pause before each action so a headed run is followable. 0 = full speed.
WEB_SLOW_MO_MS=300
WEB_VIEWPORT=1280x800
WEB_ROUNDS=2
WEB_MAX_STEPS=30
WEB_TIMEOUT=420
# Executor model. Defaults to EXECUTOR_LLM_* above; override to use a different
# model for the browser than for the device.
WEB_LLM_PROVIDER=
WEB_LLM_MODEL=

# Start every test already signed in. Produce the file once with:
#   playwright codegen --save-storage=auth.json https://your-site/login
# This is the web equivalent of "the device is already logged in", and it is the
# only reliable way past a login the agent cannot complete on its own.
WEB_STORAGE_STATE=

# Credentials for the BROWSER agent, if it must sign in itself. Never seen by
# the planner (same split as APP_LOGIN_* above).
WEB_LOGIN_URL=
WEB_LOGIN_USER=
WEB_LOGIN_PASSWORD=
WEB_LOGIN_HINT=

# Guardrails. An exploratory agent on a website has no sandbox: these are the
# only thing stopping it from ending its own session or deleting the account.
WEB_SAME_ORIGIN_ONLY=true
# Comma-separated. Override when one of these IS the thing under test.
WEB_BLOCKED_TEXTS=
WEB_BLOCKED_URL_PATTERNS=

# Passive oracles. Collected always; allowed to FAIL a test only when enabled.
# Turn these on once you know the site's baseline console/network noise.
WEB_FAIL_ON_PAGE_ERROR=false
WEB_FAIL_ON_HTTP_5XX=false
WEB_CONSOLE_IGNORE=

# ── Live Logging (Better Stack / Logtail) ──
# Get your source token from: https://logs.betterstack.com → Sources → Python
LOGTAIL_SOURCE_TOKEN=

# ── Local Logging (structlog) ──
LOG_LEVEL=INFO
LOG_FILE=logs/app.jsonl
# ── Exploration strategy ──
# exploit  = drill into areas that have already broken (defect-prone depth)
# explore  = push into untested areas (coverage breadth)
# balanced = investigate failures first, then expand (default)
EXPLORATION_MODE=balanced

# ── Local stack (start.sh / stop.sh) ──
# These are auto-detected with sensible macOS defaults; override only if yours differ.
# Path to your local Neo4j Desktop-managed DBMS directory (contains bin/neo4j):
# NEO4J_DBMS_DIR=/Users/you/Library/Application Support/neo4j-desktop/Application/Data/dbmss/dbms-<uuid>
# JRE bundled with Neo4j Desktop (auto-detected under .../Cache/runtime/zulu*jre* if unset):
# NEO4J_JAVA_HOME=
# Android emulator binary + AVD name to launch:
# ANDROID_EMULATOR=/Users/you/Library/Android/sdk/emulator/emulator
# EMULATOR_AVD=MyEmulator
