# ── Project and data paths ──
PROJECT=contacts-app
PROJECT_NAME=contacts-app
APP_NAME=contacts app
SRS_PATH=./data/inputs/SRS1.txt
FIGMA_PATH=./data/inputs/GENERATED_JSON.json

# ── Generic LLM API config ──
LLM_PROVIDER=mistral
LLM_MODEL=mistral/devstral-2512
LLM_API_KEY=your_new_mistral_api_key_here
LLM_API_BASE=

# ── Neo4j config ──
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=jms12345

# ── Optional API auth keys ──
RAG_API_KEY=
GATEWAY_API_KEY=

# ── Service URLs ──
RAG_API_URL=http://127.0.0.1:9010
RAG_URL=http://127.0.0.1:9010
GATEWAY_URL=http://127.0.0.1:9100

# ── Model Backend for Gateway ──
MODEL_BACKEND=local
MODEL_API_URL=http://127.0.0.1:8000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

GEMINI_API_KEY=
PLANNER_GEMINI_MODEL=gemini-2.5-pro

# ── Generation and simulation tuning ──
TOP_K=8
SIM_ROUNDS=3
SIM_FAIL_EVERY=5

# ── Debug/reset toggles ──
DEBUG_TRACE=0
RESET_TESTS_FIRST=0
RESET_ALL_FIRST=0

# ── Executor config ──
EXECUTOR_LLM_PROVIDER=GoogleGenAI
EXECUTOR_LLM_MODEL=gemini-2.5-pro
EXECUTOR_TIMEOUT=120
EXECUTOR_ROUNDS=2
TARGET_APP_PACKAGE=com.android.contacts

# ── Logging ──
LOGTAIL_SOURCE_TOKEN=