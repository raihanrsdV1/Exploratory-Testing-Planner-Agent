{
  "name": "dataghurhi-auth",
  "kind": "web",
  "project": "dataghurhi-auth",
  "display_name": "DataGhurhi (signed in)",
  "description": "DataGhurhi as a signed-in tester, via a captured session. THROWAWAY ACCOUNT ONLY — the agent acts as that user. Destructive/irreversible controls stay blocked.",
  "web": {
    "base_url": "https://dataghurhi.cse.buet.ac.bd",
    "browser": "chromium",
    "headless": false,
    "slow_mo_ms": 300,
    "viewport": "1280x800",
    "same_origin_only": true,
    "blocked_texts": [
      "delete",
      "মুছে ফেলুন",
      "remove",
      "log out",
      "logout",
      "sign out",
      "লগ আউট",
      "buy now",
      "এখনই কিনুন",
      "subscribe",
      "pay",
      "payment",
      "checkout",
      "upgrade",
      "invite",
      "send invitation",
      "send otp",
      "verify otp",
      "resend otp",
      "sign up",
      "signup",
      "সাইন আপ",
      "register",
      "create account",
      "publish"
    ],
    "blocked_url_patterns": [
      "/api/submit-survey",
      "/api/register",
      "/api/send-otp",
      "/api/verify-otp",
      "/api/payment",
      "/api/subscription",
      "/subscription",
      "/logout",
      "/signout"
    ],
    "storage_state": "auth.json",
    "fail_on_page_error": false,
    "fail_on_http_5xx": true,
    "console_ignore": [
      "favicon",
      "third-party cookie",
      "devtools",
      "recaptcha",
      "google",
      "gstatic",
      "translate",
      "deprecated",
      "preload",
      "sourcemap",
      "chunk"
    ],
    "login": {
      "url": "",
      "user": "",
      "password": "",
      "hint": "",
      "role": "signed-in tester (throwaway account)"
    }
  },
  "android": {
    "package": "",
    "activity": "",
    "labels": [],
    "target_app_only": false,
    "device_reset": "pm_clear",
    "login": {
      "url": "",
      "user": "",
      "password": "",
      "hint": "",
      "role": ""
    }
  },
  "knowledge": {
    "srs_path": "./data/inputs/dataghurhi-spec.md",
    "figma_path": "",
    "defects_path": ""
  },
  "run": {
    "rounds": 5,
    "max_steps": 30,
    "timeout": 420,
    "clean_slate": true,
    "self_heal": true
  },
  "model": {
    "provider": "",
    "model": ""
  }
}
