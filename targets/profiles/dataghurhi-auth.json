{
  "name": "dataghurhi-auth",
  "kind": "web",
  "project": "dataghurhi-auth",
  "display_name": "DataGhurhi (signed in)",
  "description": "DataGhurhi signed in via stored session — authenticated surface only (auth/registration flows belong to the 'dataghurhi' profile).",
  "web": {
    "base_url": "https://dataghurhi.cse.buet.ac.bd",
    "browser": "chromium",
    "headless": false,
    "slow_mo_ms": 300,
    "viewport": "1280x800",
    "same_origin_only": true,
    "blocked_texts": [
      "log out",
      "logout",
      "sign out",
      "লগ আউট",
      "update password",
      "change password",
      "reset password",
      "delete account",
      "deactivate account",
      "close account",
      "delete project",
      "delete survey",
      "delete response",
      "delete all",
      "buy now",
      "এখনই কিনুন",
      "pay",
      "payment",
      "checkout",
      "subscribe",
      "upgrade",
      "send invitation",
      "send otp",
      "verify otp",
      "resend otp",
      "sign up",
      "signup",
      "সাইন আপ",
      "register",
      "create account"
    ],
    "blocked_url_patterns": [
      "/api/payment",
      "/api/register",
      "/api/send-otp",
      "/api/submit-survey",
      "/api/subscription",
      "/api/verify-otp",
      "/logout",
      "/sign-out",
      "/signout",
      "/subscription"
    ],
    "storage_state": "auth.json",
    "fail_on_page_error": false,
    "fail_on_http_5xx": true,
    "console_ignore": [
      "favicon",
      "third-party cookie",
      "devtools",
      "recaptcha",
      "google",
      "gstatic",
      "translate",
      "deprecated",
      "preload",
      "sourcemap",
      "chunk"
    ],
    "login": {
      "url": "",
      "user": "",
      "password": "",
      "hint": "",
      "role": "signed-in tester (throwaway account)"
    }
  },
  "android": {
    "package": "",
    "activity": "",
    "labels": [],
    "target_app_only": false,
    "device_reset": "pm_clear",
    "login": {
      "url": "",
      "user": "",
      "password": "",
      "hint": "",
      "role": ""
    }
  },
  "knowledge": {
    "srs_path": "./data/inputs/dataghurhi-auth-spec.md",
    "figma_path": "",
    "defects_path": ""
  },
  "run": {
    "rounds": 5,
    "max_steps": 80,
    "timeout": 600,
    "clean_slate": false,
    "self_heal": true
  },
  "model": {
    "provider": "",
    "model": ""
  }
}
