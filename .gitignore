# ── Secrets ──────────────────────────────────────────────────────────────────
.env

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
_notes/

.claude
# ── Virtual environments ──────────────────────────────────────────────────────
.venv
venv/
env/
.venv_py_3_13

# ── Node / React dashboard ────────────────────────────────────────────────────
node_modules/
dashboard-react/dist/

# ── Live App Model runtime artifacts (state screenshots) ──────────────────────
data/appmodel/

# ── Captured browser sessions (Playwright storage_state) ──────────────────────
# These hold live auth cookies/tokens for the site under test — committing one
# hands over a logged-in session.
auth.json
*.auth.json
*storage_state*.json

# ── Documents uploaded through the dashboard's target form ────────────────────
# A tester's own SRS/Figma/defects files: another project's requirements, and
# potentially confidential. The curated specs beside them in data/inputs/ are
# tracked; these are not.
data/inputs/uploads/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Logs & runtime output ─────────────────────────────────────────────────────
logs/
*.log
simulation_result.txt
pids/
*.pid

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.env.bak.*
.env.*.bak

# BookStack benchmark session (live admin cookie)
bookstack-auth.json
*-auth.json

# ── Capstone report ───────────────────────────────────────────────────────────
# LaTeX build artefacts. The compiled template.pdf IS tracked, deliberately.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz

# Pre-anonymisation run reports. These still name the application under test;
# only the anonymised webapp-*.pdf versions beside them may be published.
report/extra_report/dataghurhi-*.pdf

# ── Android build output ──────────────────────────────────────────────────────
*.apk
